# Build the Go binary on the native BuildKit platform and cross-compile it for
# the requested target. This avoids QEMU-emulating the Go toolchain for arm64.
FROM --platform=$BUILDPLATFORM golang:1.27.0@sha256:0ecdc2a9f6156af6451080bfe3d8382a662fcc4e209608c6f919e643453514c1 AS build
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags='-s -w' -o /out/platform-reconciler ./cmd/platform-reconciler

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/platform-reconciler /platform-reconciler
# Keep this numeric so Kubernetes can verify runAsNonRoot before the
# distroless image is started. Named users cause CreateContainerConfigError
# under the Restricted Pod Security profile.
USER 65532:65532
ENTRYPOINT ["/platform-reconciler"]
