{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "EnvPilot umbrella chart values",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "enabled": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-fA-F0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "sourceRevision": { "type": "string" },
        "release": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string" },
        "existingClaim": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["", "internal", "external", "disabled"] },
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string" }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "urlKey": { "type": "string" }
          }
        },
        "persistence": { "$ref": "#/definitions/persistence" }
      },
      "allOf": [
        {
          "if": { "required": ["mode"], "properties": { "mode": { "const": "external" } } },
          "then": {
            "properties": {
              "external": {
                "required": ["existingSecret"],
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "managed", "existing", "disabled"] },
        "provider": { "type": "string" },
        "existingClassName": { "type": "string" },
        "existingSecret": { "type": "string" },
        "domainFilters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "zoneFilters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "ownershipId": { "type": "string" },
        "policy": { "type": "string", "enum": ["sync", "upsert-only"] },
        "namespace": { "type": "string" },
        "version": { "type": "string" },
        "ownership": { "type": "string", "enum": ["external", "envpilot"] },
        "credentials": {
          "type": "object", "additionalProperties": false,
          "properties": { "existingSecret": { "type": "string" } }
        },
        "state": { "type": "string", "enum": ["", "detected", "managed", "missing", "incompatible", "degraded", "disabled", "declared", "pending", "ready", "unavailable"] },
        "managed": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "chartRef": { "type": "string" },
            "version": { "type": "string" },
            "releaseName": { "type": "string" },
            "namespace": { "type": "string" },
            "values": { "type": "object" },
            "cleanupPolicy": { "type": "string", "enum": ["retain", "delete"] },
            "smoke": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "serviceName": { "type": "string" },
                "namespace": { "type": "string" },
                "port": { "type": "integer", "minimum": 1 },
                "host": { "type": "string" }
              }
            },
            "rbacRules": { "type": "array", "items": { "type": "object" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["auto", "managed"] } } },
          "then": { "required": ["provider"] }
        }
      ]
    },
    "firstStartRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["disabled", "managed", "existing"] },
        "secretName": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "tokenTTLSeconds": { "type": "integer", "minimum": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "productId": { "type": "string", "minLength": 1 },
            "appRepositoryId": { "type": "string", "minLength": 1 },
            "gitopsRepositoryId": { "type": "string", "minLength": 1 }
          }
        },
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "id": { "type": "string" } }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "id": { "type": "string", "minLength": 1 } }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string" },
            "deploymentMode": { "type": "string", "enum": ["helm", "gitops"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["mode"], "properties": { "mode": { "enum": ["managed", "existing"] } } },
          "then": {
            "required": ["project", "cluster", "agent", "runner"],
            "properties": {
              "project": { "required": ["id", "productId", "appRepositoryId", "gitopsRepositoryId"] },
              "cluster": {
                "required": ["id"],
                "properties": { "id": { "minLength": 1 } }
              },
              "agent": { "required": ["id"] },
              "runner": { "required": ["id", "deploymentMode"] }
            }
          }
        },
        {
          "if": { "required": ["mode"], "properties": { "mode": { "const": "existing" } } },
          "then": {
            "required": ["existingSecret"],
            "properties": { "existingSecret": { "minLength": 1 } }
          }
        }
      ]
    },
    "e2eFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "baseNamespace": { "type": "string" },
        "featureNamespace": { "type": "string" },
        "chartRef": { "type": "string" },
        "chartVersion": { "type": "string" },
        "appRepositoryURL": { "type": "string" },
        "gitopsRepositoryURL": { "type": "string" },
        "scmProvider": { "type": "string", "enum": ["github", "gitlab"] },
        "appDefaultBranch": { "type": "string" },
        "gitopsDefaultBranch": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "required": ["baseNamespace", "featureNamespace", "chartRef", "chartVersion", "appRepositoryURL", "gitopsRepositoryURL"],
            "properties": {
              "baseNamespace": { "minLength": 1 },
              "featureNamespace": { "minLength": 1 },
              "chartRef": { "minLength": 1 },
              "chartVersion": { "minLength": 1 },
              "appRepositoryURL": { "minLength": 1 },
              "gitopsRepositoryURL": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resources" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "imagePullSecrets": { "$ref": "#/definitions/security/properties/imagePullSecrets" }
      }
    },
    "platformDependencyReconciler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "imagePullSecrets": { "$ref": "#/definitions/security/properties/imagePullSecrets" },
        "serviceAccount": {
          "type": "object", "additionalProperties": false,
          "properties": { "create": { "type": "boolean" }, "name": { "type": "string" } }
        },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "cleanupManagedOnUninstall": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "envpilot": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platformDependencyStatus": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "enabled": { "type": "boolean" } }
            },
            "firstStartRegistration": { "$ref": "#/definitions/firstStartRegistration" },
            "e2eFixture": { "$ref": "#/definitions/e2eFixture" }
          }
        }
      }
    },
    "controlPlane": { "$ref": "#/definitions/enabled" },
    "frontend": { "$ref": "#/definitions/enabled" },
    "agent": { "$ref": "#/definitions/enabled" },
    "runner": { "$ref": "#/definitions/enabled" },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["disabled", "ingress", "gateway"] },
        "ingress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "className": { "type": "string" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" },
            "hostnames": { "type": "array", "items": { "type": "string" } }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controlPlaneName": { "type": "string", "minLength": 1 },
            "frontendName": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["mode"], "properties": { "mode": { "const": "ingress" } } },
          "then": {
            "properties": {
              "ingress": {
                "required": ["host"],
                "properties": { "host": { "minLength": 1 } }
              }
            }
          }
        },
        {
          "if": { "required": ["mode"], "properties": { "mode": { "const": "gateway" } } },
          "then": {
            "properties": {
              "gateway": {
                "required": ["name"],
                "properties": { "name": { "minLength": 1 } }
              }
            }
          }
        }
      ]
    },
    "platformDependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingress": { "$ref": "#/definitions/dependency" },
        "dns": { "$ref": "#/definitions/dependency" },
        "storage": { "$ref": "#/definitions/dependency" }
      }
    },
    "platformDependencyReconciler": { "$ref": "#/definitions/platformDependencyReconciler" },
    "envpilot-control-plane": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
              }
            },
            "postgres": { "$ref": "#/definitions/database" },
            "redis": { "$ref": "#/definitions/database" },
            "persistence": { "$ref": "#/definitions/persistence" },
            "secretEnv": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      ]
    },
    "envpilot-frontend": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "service": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
              }
            }
          }
        }
      ]
    },
    "envpilot-agent": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "controlPlane": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "url": { "type": "string" },
                "existingSecret": { "type": "string" },
                "registrationTokenKey": { "type": "string" }
              }
            },
            "agent": {
              "type": "object",
              "additionalProperties": true,
              "properties": { "authPersistence": { "$ref": "#/definitions/persistence" } }
            }
          }
        }
      ]
    },
    "envpilot-runner": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "properties": {
            "controlPlane": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "url": { "type": "string" },
                "existingSecret": { "type": "string" },
                "tokenKey": { "type": "string" },
                "configTokenKey": { "type": "string" },
                "authPersistence": { "$ref": "#/definitions/persistence" }
              }
            },
            "helmRegistry": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "existingSecret": { "type": "string" },
                "configKey": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
