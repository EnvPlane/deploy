{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "exporterImage": {"type": "string", "minLength": 1},
    "prometheusImage": {"type": "string", "minLength": 1},
    "nodeName": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9.-]+$"},
    "nodeAddress": {"type": "string", "pattern": "^[0-9.]+$"},
    "apiAddressCIDR": {"type": "string", "pattern": "^[0-9.]+/32$"},
    "apiPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "exporters": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["namespace", "name", "runAsUser", "tlsSecret", "claims"],
        "properties": {
          "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "tlsSecret": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "runAsUser": {"type": "integer", "minimum": 1},
          "claims": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "uid", "component"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
                "uid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
                "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"}
              }
            }
          }
        }
      }
    }
  }
}
