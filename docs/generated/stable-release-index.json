{
  "schemaVersion": 1,
  "channel": "stable",
  "version": "0.4.576",
  "sourceRevision": "c085898553bb2b028f3987572d22b611f3f3943e",
  "chart": {
    "repository": "oci://ghcr.io/envplane/envplane",
    "digest": "sha256:18dde501e92d02bdd0454f75f1c26d89684edb8f6e8473b8999785004a5acb07"
  },
  "support": {
    "kubernetes": {
      "minimum": "1.26.0"
    },
    "helm": {
      "minimum": "3.14.0"
    },
    "deploymentModes": [
      "cloud",
      "on-prem"
    ],
    "clusterTargets": [
      "current",
      "remote"
    ]
  },
  "install": {
    "release": "envplane",
    "namespace": "envplane",
    "command": "helm upgrade --install envplane oci://ghcr.io/envplane/envplane --version 0.4.576 --namespace envplane --create-namespace --wait",
    "prerequisites": [
      "kubernetes",
      "helm",
      "default-storage-class",
      "namespace-rbac",
      "public-oci-egress"
    ]
  },
  "status": {
    "commands": [
      "kubectl -n envplane rollout status deployment/envplane-control-plane --timeout=10m",
      "kubectl -n envplane rollout status deployment/envplane-frontend --timeout=10m",
      "kubectl -n envplane port-forward svc/envplane-frontend 3000:3000"
    ]
  },
  "firstRun": {
    "url": "http://127.0.0.1:3000",
    "screen": "initial-authentication"
  }
}
