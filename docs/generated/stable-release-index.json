{
  "schemaVersion": 1,
  "channel": "stable",
  "version": "0.4.529",
  "sourceRevision": "7c8addcfc1d46f31fc372a6863bb3a1586e88c30",
  "chart": {
    "repository": "oci://ghcr.io/envplane/envplane",
    "digest": "sha256:1d262ffd75030a798653a3c71cc76bc1f6f358c789d883f25420fc4be5e65497"
  },
  "support": {
    "kubernetes": {
      "minimum": "1.26.0"
    },
    "helm": {
      "minimum": "3.14.0"
    },
    "deploymentModes": [
      "cloud",
      "on-prem"
    ],
    "clusterTargets": [
      "current",
      "remote"
    ]
  },
  "install": {
    "release": "envplane",
    "namespace": "envplane",
    "command": "helm upgrade --install envplane oci://ghcr.io/envplane/envplane --version 0.4.529 --namespace envplane --create-namespace --wait",
    "prerequisites": [
      "kubernetes",
      "helm",
      "default-storage-class",
      "namespace-rbac",
      "public-oci-egress"
    ]
  },
  "status": {
    "commands": [
      "kubectl -n envplane rollout status deployment/envplane-control-plane --timeout=10m",
      "kubectl -n envplane rollout status deployment/envplane-frontend --timeout=10m",
      "kubectl -n envplane port-forward svc/envplane-frontend 3000:3000"
    ]
  },
  "firstRun": {
    "url": "http://127.0.0.1:3000",
    "screen": "initial-authentication"
  }
}
