{
  "schemaVersion": 1,
  "channel": "stable",
  "version": "0.4.559",
  "sourceRevision": "6a02c94d651200d5035f82c28fc7b515261d40ea",
  "chart": {
    "repository": "oci://ghcr.io/envplane/envplane",
    "digest": "sha256:4c5f0b05df97806ef467da735f9c8486b246896d841bea37d002541a74041815"
  },
  "support": {
    "kubernetes": {
      "minimum": "1.26.0"
    },
    "helm": {
      "minimum": "3.14.0"
    },
    "deploymentModes": [
      "cloud",
      "on-prem"
    ],
    "clusterTargets": [
      "current",
      "remote"
    ]
  },
  "install": {
    "release": "envplane",
    "namespace": "envplane",
    "command": "helm upgrade --install envplane oci://ghcr.io/envplane/envplane --version 0.4.559 --namespace envplane --create-namespace --wait",
    "prerequisites": [
      "kubernetes",
      "helm",
      "default-storage-class",
      "namespace-rbac",
      "public-oci-egress"
    ]
  },
  "status": {
    "commands": [
      "kubectl -n envplane rollout status deployment/envplane-control-plane --timeout=10m",
      "kubectl -n envplane rollout status deployment/envplane-frontend --timeout=10m",
      "kubectl -n envplane port-forward svc/envplane-frontend 3000:3000"
    ]
  },
  "firstRun": {
    "url": "http://127.0.0.1:3000",
    "screen": "initial-authentication"
  }
}
