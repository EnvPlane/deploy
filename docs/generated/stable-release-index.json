{
  "schemaVersion": 1,
  "channel": "stable",
  "version": "0.4.199",
  "sourceRevision": "2b2caed2dec6ca8fa25531ad0054e18305f9b514",
  "chart": {
    "repository": "oci://ghcr.io/envplane/envplane",
    "digest": "sha256:d44fa8c2be9bcdde3e9c513398902ad96776b47cfc514dc7047bfe3a79364f39"
  },
  "support": {
    "kubernetes": {
      "minimum": "1.26.0"
    },
    "helm": {
      "minimum": "3.14.0"
    },
    "deploymentModes": [
      "cloud",
      "on-prem"
    ],
    "clusterTargets": [
      "current",
      "remote"
    ]
  },
  "install": {
    "release": "envplane",
    "namespace": "envplane",
    "command": "helm upgrade --install envplane oci://ghcr.io/envplane/envplane --version 0.4.199 --namespace envplane --create-namespace --wait",
    "prerequisites": [
      "kubernetes",
      "helm",
      "default-storage-class",
      "namespace-rbac",
      "public-oci-egress"
    ]
  },
  "status": {
    "commands": [
      "kubectl -n envplane rollout status deployment/envplane-control-plane --timeout=10m",
      "kubectl -n envplane rollout status deployment/envplane-frontend --timeout=10m",
      "kubectl -n envplane port-forward svc/envplane-frontend 3000:3000"
    ]
  },
  "firstRun": {
    "url": "http://127.0.0.1:3000",
    "screen": "initial-authentication"
  }
}
