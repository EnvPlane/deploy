{
  "schemaVersion": 1,
  "channel": "stable",
  "version": "0.4.447",
  "sourceRevision": "30bb2a06b4698fd51ccbec4e3640808e0c06af6c",
  "chart": {
    "repository": "oci://ghcr.io/envplane/envplane",
    "digest": "sha256:069a5e3b0ef31eeea7f1188dfdf34527db59fd3c90c238066ec6acb95d46e716"
  },
  "support": {
    "kubernetes": {
      "minimum": "1.26.0"
    },
    "helm": {
      "minimum": "3.14.0"
    },
    "deploymentModes": [
      "cloud",
      "on-prem"
    ],
    "clusterTargets": [
      "current",
      "remote"
    ]
  },
  "install": {
    "release": "envplane",
    "namespace": "envplane",
    "command": "helm upgrade --install envplane oci://ghcr.io/envplane/envplane --version 0.4.447 --namespace envplane --create-namespace --wait",
    "prerequisites": [
      "kubernetes",
      "helm",
      "default-storage-class",
      "namespace-rbac",
      "public-oci-egress"
    ]
  },
  "status": {
    "commands": [
      "kubectl -n envplane rollout status deployment/envplane-control-plane --timeout=10m",
      "kubectl -n envplane rollout status deployment/envplane-frontend --timeout=10m",
      "kubectl -n envplane port-forward svc/envplane-frontend 3000:3000"
    ]
  },
  "firstRun": {
    "url": "http://127.0.0.1:3000",
    "screen": "initial-authentication"
  }
}
